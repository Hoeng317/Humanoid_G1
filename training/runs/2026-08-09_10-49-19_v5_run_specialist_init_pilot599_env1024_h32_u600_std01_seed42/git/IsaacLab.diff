-    }
-
-    def get_mira_obs(self) -> dict:
-        """
-        Return MIRA-ready observations for all environments.
-
-        Returns a dict with:
-          rgb_static : [N, 3, 128, 128] float32 in [0, 1]
-          rgb_wrist  : [N, 3, 128, 128] float32 in [0, 1]
-          proprio    : [N, 15] float32
-                       layout: arm_joint_pos[7] | arm_joint_vel[7] | gripper_width[1]
-          task_text  : str — natural-language task description
-          ee_pos     : [N, 3] float32 — end-effector world position
-          goal_pos   : [N, 3] float32 — goal world position
-        """
-        # ── Camera images ──────────────────────────────────────────────────────
-        # IsaacLab Camera.data.output["rgb"] → [N, H, W, 4] uint8 (RGBA)

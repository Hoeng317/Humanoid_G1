+            return (chw - mean) / std
+
+        if hasattr(self, "_static_camera") and self._static_camera is not None:
+            rgb_static = _to_chw(self._static_camera.data.output["rgb"])
+        else:
+            rgb_static = torch.zeros((self.num_envs, 3, 128, 128), device=self.device, dtype=torch.float32)
+
+        if hasattr(self, "_wrist_camera") and self._wrist_camera is not None:
+            rgb_wrist = _to_chw(self._wrist_camera.data.output["rgb"])
+        else:
+            rgb_wrist = torch.zeros_like(rgb_static)
+
+        arm_joint_pos = self._robot.data.joint_pos[:, self._arm_joint_ids]
+        arm_joint_vel = self._robot.data.joint_vel[:, self._arm_joint_ids]
+        gripper_width = self._robot.data.joint_            _finger_joint_ids].sum(dim=-1, keepdim=True)
+        proprio = torch.cat([arm_joint_pos, arm_joint_vel, gripper_width], dim=-1)
+
+        ee_pos = self._robot.data.body_pos_w[:, self._ee_body_id]
+        task_text = self._TASK_DESCRIPTIONS.get(self.cfg.task_name, self._TASK_DESCRIPTIONS["base"])
+
+        return {
+            "rgb_static": rgb_static,
+            "rgb_wrist": rgb_wrist,
+            "proprio": proprio,
+            "task_text": task_text,
+            "ee_pos": ee_pos,
+            "goal_pos": self._goal_pos.clone(),
+        }

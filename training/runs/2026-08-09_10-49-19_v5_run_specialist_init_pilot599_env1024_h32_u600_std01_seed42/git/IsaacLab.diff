-class WaypointPolicy:
-    """
-    CoppeliaSim/RLBench 방식 waypoint 컨트롤러.
-
-    사용법:
-        policy = WaypointPolicy(env, task_name)
-        # 매 스텝:
-        chunk  = policy.predict(obs_flat)          # (B, K, 8)
-        # env.step() 후:
-        done   = policy.check_waypoint_done(obs_t) # (B,) bool
-        policy.advance_waypoint(done)              # 다음 waypoint로 전이
-    """
-
-    def __init__(self, env, task_name: str, chunk_size: int = CHUNK_SIZE):
-        self._uw        = env.unwrapped if hasattr(env, "unwrapped") else env
-        self.num_envs   = self._uw.num_envs
-        self.device     = self._uw.device
-        self.task_name  = task_name
-        self.chunk_size = chunk_size
-
-        if task_name not in _WP_DEFS:
-            raise ValueError(f"WaypointPolicy: unknown task '{task_name}'. "
-                             f"Choose from {list(_WP_DEFS)}")
-
-        self._wps    = _WP_DEFS[task_name]
-        self.num_wps = len(self._wps)
-
-        self.waypoint_idx = torch.zeros(
-            self.num_envs, dtype=torch.long, device=self.device)
-        # 현재 waypoint에서 머문 스텝 수 (timeout 판정용)
-        self._wp_step_count = torch.zeros(
-            self.num_envs, dtype=torch.long, device=self.device)
-
-        # DLS λ (댐핑 계수). 작을수록 수렴 빠름, 특이점 근처 불안정 가능
-        self._dls_lam2 = 0.01 ** 2
-
-    # ── Public API ───────────────────────────────────────────────────────────
-
-    def reset(self, env_ids: torch.Tensor | None = None) -> None:
-        if env_ids is None:
-            env_ids = torch.arange(self.num_envs, device=self.device)
-        self.waypoint_idx[env_ids]    = 0
-        self._wp_step_count[env_ids]  = 0
-
-    def predict(self, obs_flat: torch.Tensor) -> torch.Tensor:
-        """
-        현재 waypoint를 향한 K-step 액션 청크를 생성.
-        waypoint 전이는 predict() 내에서 하지 않음 — 호출자가
-        env.step() 후 check_waypoint_done() + advance_waypoint()를 호출.
-
-        obs_flat : (B, 57) policy observation (CUDA)
-        Returns  : (B, K, 8) action chunk (CUDA)
-        """
-        obs_t = self._parse_obs(obs_flat)
-        self._wp_step_count += 1
-
-        target      = self._get_target(obs_t)       # (B, 3)
-        gripper_cmd = self._get_gripper_cmd()        # (B,)
-        gain        = torch.full(
-            (self.num_envs,), 8.0, device=self.device)
-
-        return self._build_chunk(obs_t, target, gain, gripper_cmd)
-
-    def check_waypoint_done(self, obs_t: dict) -> torch.Tensor:
-        """
-        현재 waypoint의 완료 조건 평가.
-        obs_t: _parse_obs() 결과 또는 동등한 딕셔너리.
-        Returns: (B,) bool CUDA
-        """
-        wp     = self.waypoint_idx
-        result = torch.zeros(self.num_envs, dtype=torch.bool, device=self.device)
-
-        for i, wp_def in enumerate(self._wps):
-            is_cur = (wp == i)
-            if not is_cur.any():
-                continue
-
-            cond = self._eval_done(obs_t, i)
-
-            # timeout: 이 waypoint에서 너무 오래 머물면 강제 전진
-            if "timeout" in wp_def:
-                cond = cond | (self._wp_step_count >= wp_def["timeout"])
-
-            result = result | (is_cur & cond)
-
-        return result
-
-    def advance_waypoint(self, done_mask: torch.Tensor) -> None:
-        """
-        done_mask가 True인 env의 waypoint_idx를 +1.
-        done_mask: (B,) bool CUDA
-        """
-        next_wp = torch.clamp(self.waypoint_idx + 1, max=self.num_wps)
-        self.waypoint_idx = torch.where(done_mask, next_wp, self.waypoint_idx)
-        # 전진한 env의 스텝 카운터 초기화
-        self._wp_step_count = torch.where(
-            done_mask,
-            torch.zeros_like(self._wp_step_count),
-            self._wp_step_count,
-        )
-
-    # ── obs 파싱 ─────────────────────────────────────────────────────────────
-
-    def _parse_obs(self, obs_flat: torch.Tensor) -> dict:
-        uw = self._uw
-        table_top_z = uw.scene.env_origins[:, 2] + uw._table_top_local_z
-        ee_id = uw._ee_body_id
-        return {
-            "ee_pos":      obs_flat[:, 18:21],                            # (B, 3)
-            "ee_quat":     uw._robot.data.body_quat_w[:, ee_id, :],      # (B, 4) wxyz
-            "joint_pos":   uw._robot.data.joint_pos[:, :7],              # (B, 7)
-            "cube_pos":    obs_flat[:, 21:24],
-            "goal_pos":    obs_flat[:, 27:30],
-            "offer_pos":   obs_flat[:, 30:33],
-            "cube_owner":  uw.get_cube_owner(),   # (B,) int32 CUDA
-            "return_pos":  uw._return_pos,        # (B, 3)
-            "table_top_z": table_top_z,           # (B,)
-        }
-
-    # ── waypoint target / gripper ─────────────────────────────────────────────
-
-    def _wp_target(self, obs_t: dict, i: int) -> torch.Tensor:
-        """오브젝트 좌표 + 오프셋 → 월드 좌표 (B, 3)"""
-        wp_def = self._wps[i]
-        base   = obs_t[wp_def["obj"]]
-        offset = torch.tensor(wp_def["offset"],
-                              dtype=torch.float32, device=self.device)
-        return base + offset
-
-    def _get_target(self, obs_t: dict) -> torch.Tensor:
-        """현재 waypoint의 목표 좌표 (B, 3). 완료 상태면 EE 제자리."""
-        wp     = self.waypoint_idx
-        target = obs_t["ee_pos"].clone()
-
-        for i in range(self.num_wps):
-            mask = (wp == i).unsqueeze(-1)
-            target = torch.where(mask, self._wp_target(obs_t, i), target)
-
-        return target
-
-    def _get_gripper_cmd(self) -> torch.Tensor:
-        """현재 waypoint의 그리퍼 명령 (B,): +1=open, -1=close, 0=hold(완료)."""
-        wp  = self.waypoint_idx
-        cmd = torch.zeros(self.num_envs, device=self.device)
-
-        for i, wp_def in enumerate(self._wps):
-            cmd = torch.where(
-                wp == i,
-                torch.full_like(cmd, float(wp_def["gripper"])),
-                cmd,
-            )
-
-        return cmd
-
-    def _eval_done(self, obs_t: dict, i: int) -> torch.Tensor:
-        """waypoint i의 done 조건 평가 → (B,) bool"""
-        done_spec = self._wps[i]["done"]
-        t         = done_spec["type"]
-        tgt       = self._wp_target(obs_t, i)
-
-        if t == "at_target":
-            thr = done_spec.get("thr", 0.05)
-            return (obs_t["ee_pos"] - tgt).norm(dim=-1) < thr
-
-        elif t == "owner==2":
-            return obs_t["cube_owner"] == 2
-
-        elif t == "owner!=2":
-            return obs_t["cube_owner"] != 2
-
-        elif t == "cube_z":
-            val = done_spec.get("val", 0.15)
-            return obs_t["cube_pos"][:, 2] > (obs_t["table_top_z"] + val)
-
-        elif t == "cube_dist":
-            val = done_spec.get("val", 0.06)
-            return (obs_t["cube_pos"] - tgt).norm(dim=-1) < val
-
-        return torch.zeros(self.num_envs, dtype=torch.bool, device=self.device)
-
-    # ── DifferentialIKController 기반 IK ─────────────────────────────────────
-
-    def _get_jacobian(self) -> torch.Tensor | None:
-        """(B, 6, 7) Jacobian — DifferentialIKController가 요구하는 전체 6행 형태."""
-        try:
-            uw    = self._uw
-            J_all = uw._robot.root_physx_view.get_jacobians()  # (B, n_bodies, 6, n_joints)
-            ee_id = uw._ee_body_id
-            if uw._robot.is_fixed_base:
-                ee_id = ee_id - 1
-            return J_all[:, ee_id, :, :7]   # (B, 6, 7)
-        except Exception:
-            return None
-
-    def _compute_dq(self,
-                    target:    torch.Tensor,   # (B, 3)  목표 EE 위치
-                    obs_t:     dict,
-                    ) -> torch.Tensor:
-        """
-        직접 야코비안 DLS IK로 관절 변화량 Δq (B, 7) 계산.
-        DifferentialIKController를 우회하여 내부 상태 문제 방지.
-
-        비례 스케일링: max(|action_i|) = 1 을 유지하면서 방향 보존.
-        반환값은 이미 _ENV_DT_SCALE로 나눈 action 단위.
-        """
-        J = self._get_jacobian()
-        if J is None:
-            return torch.zeros(self.num_envs, 7, device=self.device)
-
-        ee_pos  = obs_t["ee_pos"]    # (B, 3)
-        error   = target - ee_pos    # (B, 3)  ≤ _MAX_STEP_M in magnitude
-        J_pos   = J[:, :3, :]        # (B, 3, 7)
-
-        # DLS: Δq = Jᵀ (J Jᵀ + λ²I)⁻¹ error
-        # eye3 broadcast: (3,3) → (B,3,3) via torch broadcasting
-        A    = (J_pos.bmm(J_pos.transpose(1, 2))
-                + self._dls_lam2 * torch.eye(3, device=self.device))       # (B,3,3)
-        dq   = J_pos.transpose(1, 2).bmm(
-                   torch.linalg.solve(A, error.unsqueeze(-1))
-               ).squeeze(-1)                                               # (B, 7)
-
-        # 비례 스케일링으로 방향 보존
-        action = dq / _ENV_DT_SCALE
-        scale  = action.abs().amax(dim=-1, keepdim=True).clamp(min=1.0)
-        return action / scale
-
-    def _build_chunk(self,
-                     obs_t:       dict,
-                     target:      torch.Tensor,   # (B, 3) 최종 waypoint 목표
-                     gain:        torch.Tensor,   # (B,)  — 미사용 (IK가 속도 결정)
-                     gripper_cmd: torch.Tensor,   # (B,)
-                     ) -> torch.Tensor:
-        """
-        K-step 액션 청크 생성 — Cartesian 직선 보간 방식.
-
-        매 step k마다 최종 target을 직접 쓰지 않고,
-        현재 예측 EE에서 target 방향으로 _MAX_STEP_M 이하의 중간 지점을 계산.
-        → IK는 항상 '바로 앞 좁은 목표'만 풀면 되어 팔 자세가 안정적.
-        """
-        B      = self.num_envs
-        device = self.device
-        J      = self._get_jacobian()   # (B, 6, 7) or None
-
-        pred_obs = {k: v.clone() if torch.is_tensor(v) else v
-                    for k, v in obs_t.items()}
-
-        chunk = torch.zeros(B, self.chunk_size, ACTION_DIM, device=device)
-
-        for k in range(self.chunk_size):
-            # ── 직선 보간: 예측 EE → target 방향으로 최대 _MAX_STEP_M ─────────
-            delta    = target - pred_obs["ee_pos"]          # (B, 3)
-            dist     = delta.norm(dim=-1, keepdim=True).clamp(min=1e-6)
-            step_tgt = (pred_obs["ee_pos"]
-                        + delta / dist * dist.clamp(max=_MAX_STEP_M))  # (B, 3)
-
-            action_arm = self._compute_dq(step_tgt, pred_obs)  # (B, 7)
-
-            chunk[:, k, :7] = action_arm
-            chunk[:, k,  7] = gripper_cmd
-
-            # 다음 스텝 예측값 갱신 (Jacobian 선형 근사)
-            if J is not None:
-                dq = action_arm * _ENV_DT_SCALE
-                pred_obs["ee_pos"]    = (pred_obs["ee_pos"]
-                                         + (J[:, :3, :] @ dq.unsqueeze(-1)).squeeze(-1))
-                pred_obs["joint_pos"] = pred_obs["joint_pos"] + dq
-
-        return chunk

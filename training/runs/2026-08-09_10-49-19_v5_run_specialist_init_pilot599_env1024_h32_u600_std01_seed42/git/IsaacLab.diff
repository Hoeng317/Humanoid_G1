-# SeRT/utils/success_score.py
-# Soft success score in [0, 1] for Safety Evaluator label generation.
-# Higher = closer to task completion.  All ops on CUDA tensors.
-from __future__ import annotations
-import torch
-
-
-def compute_success_score(obs_tensors: dict, task_name: str) -> torch.Tensor:
-    """
-    Return (B,) float32 CUDA tensor in [0, 1].
-
-    Used in collect_safety_labels.py recoverability labels:
-        recover[:, k] = compute_success_score(obs_after_k_steps, task_name)
-
-    Required keys in obs_tensors (same as check_success):
-        ee_pos, cube_pos, goal_pos, offer_pos, cube_owner, table_top_z
-        return_pos  (only for "return")
-    """
-    cube_pos    = obs_tensors["cube_pos"]
-    goal_pos    = obs_tensors["goal_pos"]
-    offer_pos   = obs_tensors["offer_pos"]
-    ee_pos      = obs_tensors["ee_pos"]
-    cube_owner  = obs_tensors["cube_owner"]
-    table_top_z = obs_tensors["table_top_z"]
-
-    if task_name == "reach":
-        # Exponential decay of EE-to-hand distance
-        return torch.exp(-(ee_pos - offer_pos).norm(dim=-1) * 10.0)
-
-    elif task_name == "grasp":
-        # Binary: robot owns cube
-        return (cube_owner == 2).float()
-
-    elif task_name == "lift":
-        height = torch.clamp(cube_pos[:, 2] - table_top_z, min=0.0)
-        owned  = (cube_owner == 2).float()
-        return owned * torch.clamp(height / 0.16, 0.0, 1.0)
-
-    elif task_name == "place":
-        d_xy   = (cube_pos[:, :2] - goal_pos[:, :2]).norm(dim=-1)
-        placed = (cube_pos[:, 2] < (table_top_z + 0.08)).float()
-        return placed * torch.exp(-d_xy * 5.0)
-
-    elif task_name == "return":
-        return_pos = obs_tensors["return_pos"]
-        d = (cube_pos - return_pos).norm(dim=-1)
-        return torch.exp(-d * 5.0)
-
-    else:
-        raise ValueError(f"compute_success_score: unknown task '{task_name}'")

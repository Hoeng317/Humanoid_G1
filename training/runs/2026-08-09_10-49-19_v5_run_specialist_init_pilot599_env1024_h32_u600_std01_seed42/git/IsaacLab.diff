-    "handover": [
-        {"obj": "offer_pos", "offset": [0, 0, 0.15], "gripper": +1.0,
-         "done": {"type": "at_target", "thr": 0.06}},
-        {"obj": "offer_pos", "offset": [0, 0, 0.04], "gripper": +1.0,
-         "done": {"type": "at_target", "thr": 0.08}, "timeout": 150},

-# SeRT/model/safety_evaluator.py
-# HRC Safety Evaluator — Chunk-Causal Cross-Attention Transformer
-#
-# F_phi(image, proprio, language, human, u_t) = (r_hat^(1:K), c_hat^(1:K))
-#
-# Architecture:
-#   4 modality encoders  →  context tokens (Key, Value)
-#   Causal Chunk Encoder →  query tokens
-#   Cross-Attention Decoder → per-prefix risk / recoverability heads
-
-from __future__ import annotations
-
-import torch
-import torch.nn as nn
-import torchvision.models as models
-
-from SeRT.model.config import (
-    IMAGE_C, IMAGE_H, IMAGE_W,
-    PROPRIO_DIM, LANGUAGE_DIM, HUMAN_DIM,
-    ACTION_DIM, CHUNK_SIZE, D_MODEL,
-)
-
-
-# ── Modality Encoders ───────────────────────────────────────────────────────
-
-class ImageEncoder(nn.Module):
-    """ResNet18 backbone; final FC replaced with d_model projection."""
-
-    def __init__(self, d_model: int = D_MODEL):
-        super().__init__()
-        backbone = models.resnet18(weights=None)
-        backbone.fc = nn.Linear(512, d_model)
-        self.net = backbone
-        self.norm = nn.LayerNorm(d_model)
-        # ImageNet normalisation (Isaac Lab camera outputs uint8 0-255)
-        self.register_buffer("mean", torch.tensor([0.485, 0.456, 0.406]).view(1, 3, 1, 1))
-        self.register_buffer("std",  torch.tensor([0.229, 0.224, 0.225]).view(1, 3, 1, 1))
-
-    def forward(self, x: torch.Tensor) -> torch.Tensor:
-        # x: (B, C, H, W) uint8 or float
-        x = x.float() / 255.0
-        x = (x - self.mean) / self.std
-        return self.norm(self.net(x))  # (B, d_model)
-
-
-class ProprioEncoder(nn.Module):
-    """Robot state + object state encoder."""
-
-    def __init__(self, proprio_dim: int = PROPRIO_DIM, d_model: int = D_MODEL):
-        super().__init__()
-        self.net = nn.Sequential(
-            nn.Linear(proprio_dim, d_model),
-            nn.LayerNorm(d_model),
-            nn.ReLU(),
-            nn.Linear(d_model, d_model),
-            nn.LayerNorm(d_model),
-        )
-
-    def forward(self, x: torch.Tensor) -> torch.Tensor:
-        return self.net(x)  # (B, d_model)
-
-
-class LanguageEncoder(nn.Module):
-    """Projects pre-computed CLIP text embedding to d_model."""
-
-    def __init__(self, lang_dim: int = LANGUAGE_DIM, d_model: int = D_MODEL):
-        super().__init__()
-        self.proj = nn.Sequential(
-            nn.Linear(lang_dim, d_model),
-            nn.LayerNorm(d_model),
-        )
-
-    def forward(self, x: torch.Tensor) -> torch.Tensor:
-        return self.proj(x)  # (B, d_model)
-
-
-class HumanEncoder(nn.Module):
-    """Human skeleton state encoder."""
-
-    def __init__(self, human_dim: int = HUMAN_DIM, d_model: int = D_MODEL):
-        super().__init__()
-        self.net = nn.Sequential(
-            nn.Linear(human_dim, d_model),
-            nn.LayerNorm(d_model),
-            nn.ReLU(),
-            nn.Linear(d_model, d_model),
-            nn.LayerNorm(d_model),
-        )
-
-    def forward(self, x: torch.Tensor) -> torch.Tensor:
-        return self.net(x)  # (B, d_model)
-
-
-# ── Safety Evaluator ────────────────────────────────────────────────────────
-
-class SafetyEvaluator(nn.Module):
-    """
-    Chunk-Causal Cross-Attention Safety Evaluator.
-
-    Given the current observation (image, proprio, language, human) and a
-    proposed K-step action chunk u_t, predicts per-prefix:
-      - risk[b, k]           : collision / safety-violation probability
-      - recoverability[b, k] : task-recovery probability after executing k steps
-
-    The causal mask ensures that the prediction for prefix k only attends to
-    actions a_1 … a_k, not future actions.
-    """
-
-    def __init__(
-        self,
-        d_model:            int   = D_MODEL,
-        nhead:              int   = 4,
-        chunk_size:         int   = CHUNK_SIZE,
-        num_encoder_layers: int   = 3,
-        num_decoder_layers: int   = 3,
-        dropout:            float = 0.1,
-    ):
-        super().__init__()
-        self.chunk_size = chunk_size
-        self.d_model    = d_model
-
-        # 1. Per-modality encoders
-        self.image_enc   = ImageEncoder(d_model)
-        self.proprio_enc = ProprioEncoder(d_model=d_model)
-        self.lang_enc    = LanguageEncoder(d_model=d_model)
-        self.human_enc   = HumanEncoder(d_model=d_model)
-
-        # 2. Context Fusion Encoder (self-attention across 4 modality tokens)
-        ctx_layer = nn.TransformerEncoderLayer(
-            d_model, nhead, d_model * 4, dropout,
-            batch_first=True, norm_first=True,
-        )
-        self.context_encoder = nn.TransformerEncoder(ctx_layer, num_layers=num_encoder_layers)
-
-        # 3. Causal Chunk Encoder
-        #    h_k attends only to a_1 … a_k (upper-triangular mask blocks future)
-        self.action_proj = nn.Sequential(
-            nn.Linear(ACTION_DIM, d_model),
-            nn.LayerNorm(d_model),
-        )
-        self.pos_embed = nn.Embedding(chunk_size, d_model)
-        chunk_layer = nn.TransformerEncoderLayer(
-            d_model, nhead, d_model * 4, dropout,
-            batch_first=True, norm_first=True,
-        )
-        self.chunk_encoder = nn.TransformerEncoder(chunk_layer, num_layers=num_encoder_layers)
-
-        # 4. Chunk-Causal Cross-Attention Decoder  ← core novelty
-        #    Query  = causal chunk hidden states  (B, K, d_model)
-        #    Key/Value = fused context            (B, 4, d_model)
-        dec_layer = nn.TransformerDecoderLayer(
-            d_model, nhead, d_model * 4, dropout,
-            batch_first=True, norm_first=True,
-        )
-        self.cross_decoder = nn.TransformerDecoder(dec_layer, num_layers=num_decoder_layers)
-
-        # 5. Output heads
-        self.risk_head = nn.Sequential(
-            nn.Linear(d_model, d_model // 2), nn.ReLU(),
-            nn.Linear(d_model // 2, 1), nn.Sigmoid(),
-        )
-        self.task_head = nn.Sequential(
-            nn.Linear(d_model, d_model // 2), nn.ReLU(),
-            nn.Linear(d_model // 2, 1), nn.Sigmoid(),
-        )
-
-    def _causal_mask(self, K: int, device: torch.device) -> torch.Tensor:
-        """Upper-triangular bool mask: True = block (future actions)."""
-        return torch.triu(torch.ones(K, K, device=device, dtype=torch.bool), diagonal=1)
-
-    def forward(
-        self,
-        image:        torch.Tensor,  # (B, C, H, W)  uint8 or float
-        proprio:      torch.Tensor,  # (B, PROPRIO_DIM)
-        language:     torch.Tensor,  # (B, LANGUAGE_DIM)  pre-computed CLIP emb
-        human:        torch.Tensor,  # (B, HUMAN_DIM)
-        action_chunk: torch.Tensor,  # (B, K, ACTION_DIM)
-    ) -> dict[str, torch.Tensor]:
-        B, K, _ = action_chunk.shape
-        device  = action_chunk.device
-
-        # Step 1: per-modality encoding → (B, d_model) each
-        img_feat  = self.image_enc(image)
-        prop_feat = self.proprio_enc(proprio)
-        lang_feat = self.lang_enc(language)
-        hum_feat  = self.human_enc(human)
-
-        # Step 2: stack → (B, 4, d_model) → context fusion
-        ctx = torch.stack([img_feat, prop_feat, lang_feat, hum_feat], dim=1)
-        ctx = self.context_encoder(ctx)  # (B, 4, d_model)
-
-        # Step 3: causal chunk encoding
-        pos    = torch.arange(K, device=device)
-        a_feat = self.action_proj(action_chunk) + self.pos_embed(pos)  # (B, K, d_model)
-        h      = self.chunk_encoder(a_feat, mask=self._causal_mask(K, device))  # (B, K, d_model)
-
-        # Step 4: cross-attention — each prefix attends to all context
-        # tgt_mask keeps the decoder self-attention causal so that ev[k]
-        # depends only on h[0..k], which itself only depends on a[0..k].
-        ev = self.cross_decoder(tgt=h, memory=ctx,
-                                tgt_mask=self._causal_mask(K, device))  # (B, K, d_model)
-
-        # Step 5: per-prefix heads
-        return {
-            "risk":           self.risk_head(ev).squeeze(-1),   # (B, K)
-            "recoverability": self.task_head(ev).squeeze(-1),   # (B, K)
-        }
-
-    @torch.no_grad()
-    def find_safe_prefix(
-        self,
-        image:        torch.Tensor,
-        proprio:      torch.Tensor,
-        language:     torch.Tensor,
-        human:        torch.Tensor,
-        action_chunk: torch.Tensor,
-        risk_thr:     float = 0.4,
-        rec_thr:      float = 0.5,
-    ) -> list[int]:
-        """
-        Return the longest safe prefix length for each env in the batch.
-
-        Returns a list of length B where each element k means it is safe to
-        execute the first k actions of action_chunk[b].  k=0 means no action
-        is safe; replan immediately.
-        """
-        out  = self.forward(image, proprio, language, human, action_chunk)
-        risk = out["risk"]           # (B, K)
-        rec  = out["recoverability"] # (B, K)
-
-        safe_ks = []
-        for b in range(risk.shape[0]):
-            safe_k = 0
-            for k in range(self.chunk_size):
-                if risk[b, k].item() < risk_thr and rec[b, k].item() > rec_thr:
-                    safe_k = k + 1
-                else:
-                    break
-            safe_ks.append(safe_k)
-        return safe_ks

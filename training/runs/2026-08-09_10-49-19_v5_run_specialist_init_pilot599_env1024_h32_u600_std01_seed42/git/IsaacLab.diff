-            + phase_bonus
-            + success_bonus
-            - 1.5 * safety_penalty
-            - severe_penalty
-            - action_penalty
-        )
-
-        # Update previous state
-        self._prev_human_dist_to_wp[:] = m["dist_to_wp"]
-        self._prev_success[:] = m["stable_success"]
-
-        # Extras for logging
-        self.extras["human_phase"] = m["human_phase"]
-        self.extras["human_clearance"] = m["human_clearance"]
-        self.extras["dist_to_wp"] = m["dist_to_wp"]
-        self.extras["is_success"] = m["stable_success"].float()
-        self.extras["is_severe_violation"] = m["severe_violation"].float()
-
-        return reward

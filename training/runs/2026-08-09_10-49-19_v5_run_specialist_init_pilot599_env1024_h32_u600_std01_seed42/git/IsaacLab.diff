-    def __init__(
-        self,
-        waypoints: list,
-        tol: float = 0.12,
-        stop_duration: float = 2.0,
-        dt: float = _DT,
-    ) -> None:
-        self._waypoints = [np.array(wp, dtype=np.float64) for wp in waypoints]
-        self._idx = 0
-        self._done = False
-        self._tol = tol
-        self._stop_timer = 0.0
-        self._stop_duration = stop_duration
-        self._dt = dt
-
-    def reset(self) -> None:
-        self._idx = 0
-        self._done = False
-        self._stop_timer = 0.0
-
-    def step(self, human_pos: np.ndarray) -> None:
-        """Update route state based on the actual current human position."""
-        if self._done:
-            return
-        target = self._waypoints[self._idx]
-        dist = float(np.linalg.norm(human_pos[:2] - target[:2]))
-        if dist < self._tol:
-            if self._idx == len(self._waypoints) - 1:
-                # Final waypoint: wait stop_duration then mark done
-                self._stop_timer += self._dt
-                if self._stop_timer >= self._stop_duration:
-                    self._done = True
-            else:
-                self._idx += 1
-
-    def is_done(self) -> bool:
-        return self._done
-
-    def is_at_final(self) -> bool:
-        """True when the human has reached the last waypoint (waiting to mark done)."""
-        return self._idx == len(self._waypoints) - 1
-
-    def is_moving(self) -> bool:
-        """True when the human should still be walking toward the next waypoint."""
-        return not self._done and not self.is_at_final()
-
-    def get_current_target(self) -> np.ndarray:
-        """Return current active waypoint world position."""
-        return self._waypoints[min(self._idx, len(self._waypoints) - 1)].copy()

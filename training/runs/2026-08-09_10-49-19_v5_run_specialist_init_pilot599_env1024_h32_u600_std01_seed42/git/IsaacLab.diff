-#!/usr/bin/env python3
-# SeRT/envs/check_demo.py
-# 데모 HDF5 파일 분석 시각화 스크립트
-#
-# Usage:
-#   python3 SeRT/envs/check_demo.py --demo_dir data/demos
-#   python3 SeRT/envs/check_demo.py --demo_dir data/demos --save check_demo.png
-
-from __future__ import annotations
-
-import argparse
-import os
-import sys
-
-import h5py
-import numpy as np
-import matplotlib
-import matplotlib.pyplot as plt
-import matplotlib.gridspec as gridspec
-import matplotlib.patches as mpatches
-from matplotlib.colors import LinearSegmentedColormap
-from matplotlib.ticker import MaxNLocator
-
-# ── 스타일 ────────────────────────────────────────────────────────────────────
-BG      = "#0f1117"
-PANEL   = "#1a1d27"
-BORDER  = "#2a2d3a"
-TEXT    = "#e8eaf0"
-SUBTLE  = "#6b7080"
-ACCENT  = "#4c9cf8"
-GREEN   = "#48c78e"
-YELLOW  = "#ffd166"
-RED     = "#ef4565"
-PURPLE  = "#c084fc"
-
-PHASE_COLORS = {0: "#4c9cf8", 1: "#ffd166", 2: "#ff8c42", 3: "#48c78e"}
-PHASE_NAMES  = {0: "Phase 0\nApproach", 1: "Phase 1\nClose", 2: "Phase 2\nHold", 3: "Phase 3\nGoal"}
-
-matplotlib.rcParams.update({
-    "figure.facecolor":  BG,
-    "axes.facecolor":    PANEL,
-    "axes.edgecolor":    BORDER,
-    "axes.labelcolor":   TEXT,
-    "xtick.color":       SUBTLE,
-    "ytick.color":       SUBTLE,
-    "text.color":        TEXT,
-    "grid.color":        BORDER,
-    "grid.linewidth":    0.5,
-    "font.family":       "DejaVu Sans",
-    "font.size":         9,
-})
-
-
-# ── 데이터 로드 ───────────────────────────────────────────────────────────────
-def load_demos(demo_dir: str):
-    files = sorted([f for f in os.listdir(demo_dir) if f.endswith(".h5")])
-    if not files:
-        print(f"[ERROR] .h5 파일이 없습니다: {demo_dir}")
-        sys.exit(1)
-
-    demos = []
-    for f in files:
-        path = os.path.join(demo_dir, f)
-        with h5py.File(path) as hf:
-            demos.append({
-                "name":    f,
-                "obs":     hf["obs"][:],
-                "actions": hf["actions"][:],
-                "phase":   hf["phase"][:],
-                "task":    str(hf.attrs.get("task", "unknown")),
-            })
-    return demos
-
-
-# ── 집계 ─────────────────────────────────────────────────────────────────────
-def aggregate(demos):
-    steps      = np.array([len(d["obs"]) for d in demos])
-    final_ph   = np.array([int(d["phase"][-1]) for d in demos])
-    obs_all    = np.concatenate([d["obs"]    for d in demos], axis=0)
-    act_all    = np.concatenate([d["actions"] for d in demos], axis=0)
-    phase_all  = np.concatenate([d["phase"]  for d in demos], axis=0)
-
-    # handover 시점 (obs[53]=1 첫 등장)
-    handover_step  = []
-    handover_phase = []
-    for d in demos:
-        rob = np.where(d["obs"][:, 53] > 0.5)[0]
-        if len(rob) > 0:
-            handover_step.append(rob[0])
-            handover_phase.append(int(d["phase"][rob[0]]))
-        else:
-            handover_step.append(-1)
-            handover_phase.append(-1)
-
-    return {
-        "steps":         steps,
-        "final_ph":      final_ph,
-        "obs_all":       obs_all,
-        "act_all":       act_all,
-        "phase_all":     phase_all,
-        "handover_step": np.array(handover_step),
-        "handover_phase":np.array(handover_phase),
-        "task":          demos[0]["task"],
-        "n":             len(demos),
-    }
-
-
-# ── 그리기 헬퍼 ──────────────────────────────────────────────────────────────
-def _ax_style(ax, title="", xlabel="", ylabel="", grid=True):
-    ax.set_title(title, color=TEXT, fontsize=10, fontweight="bold", pad=8)
-    if xlabel: ax.set_xlabel(xlabel, fontsize=8)
-    if ylabel: ax.set_ylabel(ylabel, fontsize=8)
-    if grid:   ax.grid(True, alpha=0.4)
-    ax.spines[["top", "right"]].set_visible(False)
-    ax.spines[["left", "bottom"]].set_edgecolor(BORDER)
-
-
-# ══════════════════════════════════════════════════════════════════════════════
-def draw(demos, agg, save_path=None):
-    n_demo = agg["n"]
-    fig = plt.figure(figsize=(22, 16), facecolor=BG)
-    fig.suptitle(
-        f"Demo Dataset Analysis   task: {agg['task']}   {n_demo} demos   {len(agg['obs_all']):,} total steps",
-        color=TEXT, fontsize=13, fontweight="bold", y=0.98,
-    )
-
-    gs = gridspec.GridSpec(
-        4, 4,
-        figure=fig,
-        left=0.05, right=0.97,
-        top=0.93,  bottom=0.06,
-        hspace=0.55, wspace=0.38,
-    )
-
-    # ── [0,0] 요약 패널 ───────────────────────────────────────────────────────
-    ax_sum = fig.add_subplot(gs[0, 0])
-    ax_sum.set_facecolor(PANEL)
-    ax_sum.axis("off")
-    ax_sum.set_title("Overview", color=TEXT, fontsize=10, fontweight="bold", pad=8)
-
-    phase_cnt = {p: int((agg["final_ph"] == p).sum()) for p in range(4)}
-    ph3_ratio = 100 * phase_cnt[3] / n_demo
-    total_steps = len(agg["phase_all"])
-    ph_dist = {p: 100 * (agg["phase_all"] == p).sum() / total_steps for p in range(4)}
-
-    lines = [
-        ("Total Demos",      f"{n_demo}"),
-        ("Total Steps",      f"{total_steps:,}"),
-        ("Mean Episode",     f"{agg['steps'].mean():.0f} steps"),
-        ("min / max",        f"{agg['steps'].min()} / {agg['steps'].max()}"),
-        ("",                 ""),
-        ("End Phase 0",      f"{phase_cnt[0]}  ({100*phase_cnt[0]/n_demo:.0f}%)"),
-        ("End Phase 1",      f"{phase_cnt[1]}  ({100*phase_cnt[1]/n_demo:.0f}%)"),
-        ("End Phase 2",      f"{phase_cnt[2]}  ({100*phase_cnt[2]/n_demo:.0f}%)"),
-        ("End Phase 3",      f"{phase_cnt[3]}  ({100*phase_cnt[3]/n_demo:.0f}%)"),
-        ("",                 ""),
-        ("Phase 3 step%",    f"{ph_dist[3]:.1f}%"),
-    ]
-    y = 0.96
-    for label, val in lines:
-        color = TEXT
-        if label == "":
-            y -= 0.06
-            continue
-        ax_sum.text(0.04, y, label, color=SUBTLE, fontsize=8.5, transform=ax_sum.transAxes, va="top")
-        ax_sum.text(0.96, y, val,  color=TEXT,   fontsize=8.5, transform=ax_sum.transAxes, va="top", ha="right")
-        y -= 0.09
-
-    # ── [0,1] 에피소드 길이 분포 ──────────────────────────────────────────────
-    ax_ep = fig.add_subplot(gs[0, 1])
-    bins = np.linspace(agg["steps"].min() - 5, agg["steps"].max() + 5, 20)
-    ax_ep.hist(agg["steps"], bins=bins, color=ACCENT, alpha=0.85, edgecolor=BG, linewidth=0.4)
-    ax_ep.axvline(agg["steps"].mean(), color=YELLOW, linewidth=1.5, linestyle="--", label=f"mean={agg['steps'].mean():.0f}")
-    ax_ep.axvline(np.median(agg["steps"]), color=RED, linewidth=1.5, linestyle=":", label=f"median={np.median(agg['steps']):.0f}")
-    ax_ep.legend(fontsize=7.5, facecolor=PANEL, edgecolor=BORDER, labelcolor=TEXT)
-    _ax_style(ax_ep, "Episode Length Distribution", "Steps", "Count")
-
-    # ── [0,2] final phase 도넛 차트 ───────────────────────────────────────────
-    ax_pie = fig.add_subplot(gs[0, 2])
-    ax_pie.set_facecolor(PANEL)
-    sizes  = [phase_cnt.get(p, 0) for p in range(4)]
-    colors = [PHASE_COLORS[p] for p in range(4)]
-    labels = [f"Ph{p}: {v}" for p, v in enumerate(sizes)]
-    wedge_props = dict(width=0.45, edgecolor=BG, linewidth=1.5)

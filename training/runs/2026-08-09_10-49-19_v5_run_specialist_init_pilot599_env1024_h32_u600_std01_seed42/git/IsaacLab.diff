-# SeRT/utils/success_conditions.py
-# Per-task success condition functions.
-# All operations on CUDA tensors; .cpu().numpy() only at HDF5 save time.
-from __future__ import annotations
-import torch
-
-
-def check_success(obs_tensors: dict, task_name: str) -> torch.Tensor:
-    """
-    Return (B,) bool CUDA tensor: True = episode succeeded.
-
-    Required keys in obs_tensors:
-        ee_pos       (B, 3)
-        cube_pos     (B, 3)
-        goal_pos     (B, 3)
-        offer_pos    (B, 3)
-        cube_owner   (B,)   int — 0=none 1=human 2=robot
-        table_top_z  (B,)   world-frame z of table surface
-        return_pos   (B, 3) — required only for "return" task
-    """
-    ee_pos      = obs_tensors["ee_pos"]
-    cube_pos    = obs_tensors["cube_pos"]
-    goal_pos    = obs_tensors["goal_pos"]
-    offer_pos   = obs_tensors["offer_pos"]
-    cube_owner  = obs_tensors["cube_owner"]
-    table_top_z = obs_tensors["table_top_z"]   # (B,) or scalar
-
-    if task_name == "reach":
-        # EE within 6 cm of human hand
-        return (ee_pos - offer_pos).norm(dim=-1) < 0.06
-
-    elif task_name == "grasp":
-        # Robot owns cube
-        return cube_owner == 2
-
-    elif task_name == "lift":
-        # Robot owns cube AND cube lifted > 16 cm above table
-        robot_owns  = (cube_owner == 2)
-        high_enough = cube_pos[:, 2] > (table_top_z + 0.16)
-        return robot_owns & high_enough
-
-    elif task_name == "place":
-        # Cube within 6 cm of goal AND near table surface AND not gripped
-        close   = (cube_pos - goal_pos).norm(dim=-1) < 0.06
-        low     = cube_pos[:, 2] < (table_top_z + 0.08)
-        released = (cube_owner != 2)
-        return close & low & released
-
-    elif task_name == "return":
-        return_pos = obs_tensors["return_pos"]
-        return (cube_pos - return_pos).norm(dim=-1) < 0.06
-
-    # ── 재설계 문서 추가 task ─────────────────────────────────────────────────
-
-    elif task_name == "handover":
-        # 로봇이 큐브 보유 + EE가 사람 손에서 15cm 이상 떨어짐 (완전 수령 확인)
-        robot_owns = (cube_owner == 2)
-        ee_away    = (ee_pos - offer_pos).norm(dim=-1) > 0.15
-        return robot_owns & ee_away
-
-    elif task_name == "pick_and_place":
-        # XY 근접 + 테이블 높이 이하 + 그리퍼 해제
-        xy_close  = (cube_pos[:, :2] - goal_pos[:, :2]).norm(dim=-1) < 0.06
-        low       = cube_pos[:, 2] < (table_top_z + 0.08)
-        released  = (cube_owner != 2)
-        return xy_close & low & released
-
-    else:
-        raise ValueError(f"check_success: unknown task '{task_name}'")

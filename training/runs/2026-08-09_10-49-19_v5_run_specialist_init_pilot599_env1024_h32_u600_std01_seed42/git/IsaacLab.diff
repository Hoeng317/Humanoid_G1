-# SeRT/model/il_policy.py
-# Imitation-Learning (Behavioural Cloning) Policy.
-#
-# Architecture: same 4-modality encoders as SafetyEvaluator, but the decoder
-# is replaced by a simple self-attention fusion + MLP action head.
-#
-#   F_IL(image, proprio, language, human) → chunk (B, K, 8)
-
-from __future__ import annotations
-
-import torch
-import torch.nn as nn
-import torchvision.models as models
-
-from SeRT.model.config import (
-    IMAGE_C, IMAGE_H, IMAGE_W,
-    PROPRIO_DIM, LANGUAGE_DIM, HUMAN_DIM,
-    ACTION_DIM, CHUNK_SIZE, D_MODEL,
-)
-
-
-# ── Re-use same modality encoders as SafetyEvaluator ────────────────────────
-
-class _ImageEncoder(nn.Module):
-    def __init__(self, d: int = D_MODEL):
-        super().__init__()
-        bb = models.resnet18(weights=None)
-        bb.fc = nn.Linear(512, d)
-        self.net  = bb
-        self.norm = nn.LayerNorm(d)
-        self.register_buffer("mean", torch.tensor([0.485, 0.456, 0.406]).view(1, 3, 1, 1))
-        self.register_buffer("std",  torch.tensor([0.229, 0.224, 0.225]).view(1, 3, 1, 1))
-
-    def forward(self, x: torch.Tensor) -> torch.Tensor:
-        x = x.float() / 255.0
-        x = (x - self.mean) / self.std
-        return self.norm(self.net(x))   # (B, d)
-
-
-class _MLPEncoder(nn.Module):
-    def __init__(self, in_dim: int, d: int = D_MODEL):
-        super().__init__()
-        self.net = nn.Sequential(
-            nn.Linear(in_dim, d), nn.LayerNorm(d), nn.ReLU(),
-            nn.Linear(d, d),      nn.LayerNorm(d),
-        )
-
-    def forward(self, x: torch.Tensor) -> torch.Tensor:
-        return self.net(x)   # (B, d)
-
-
-class _ProjEncoder(nn.Module):
-    def __init__(self, in_dim: int, d: int = D_MODEL):
-        super().__init__()
-        self.proj = nn.Sequential(nn.Linear(in_dim, d), nn.LayerNorm(d))
-
-    def forward(self, x: torch.Tensor) -> torch.Tensor:
-        return self.proj(x)
-
-
-# ── IL Policy ────────────────────────────────────────────────────────────────
-
-class ILPolicy(nn.Module):
-    """
-    Behavioural-cloning policy trained with MSE loss on demonstration chunks.
-
-    Input : (image, proprio, language, human)
-    Output: chunk  (B, K, ACTION_DIM)  — normalised to [-1, 1] via Tanh
-
-    Training:
-        loss = MSE(model(obs), gt_chunk)
-    """
-
-    def __init__(
-        self,
-        d_model:    int = D_MODEL,
-        nhead:      int = 4,
-        num_layers: int = 2,
-        chunk_size: int = CHUNK_SIZE,
-        dropout:    float = 0.1,
-    ):
-        super().__init__()
-        self.chunk_size = chunk_size
-        self.d_model    = d_model
-
-        # ── Modality encoders ────────────────────────────────────────────
-        self.image_enc   = _ImageEncoder(d_model)
-        self.proprio_enc = _MLPEncoder(PROPRIO_DIM,  d_model)
-        self.lang_enc    = _ProjEncoder(LANGUAGE_DIM, d_model)
-        self.human_enc   = _MLPEncoder(HUMAN_DIM,    d_model)
-
-        # ── Cross-modal self-attention fusion (4 tokens → flat) ──────────
-        layer = nn.TransformerEncoderLayer(
-            d_model, nhead, d_model * 4, dropout,
-            batch_first=True, norm_first=True,
-        )
-        self.fusion = nn.TransformerEncoder(layer, num_layers=num_layers)
-
-        # Flatten 4 × d_model → d_model × 4 = 1024 (for d=256)
-        self.flatten_proj = nn.Sequential(
-            nn.Linear(4 * d_model, d_model * 4),
-            nn.LayerNorm(d_model * 4),
-            nn.ReLU(),
-        )
-
-        # ── Action head: predict K-step chunk ────────────────────────────
-        self.action_head = nn.Sequential(
-            nn.Linear(d_model * 4, d_model * 2),
-            nn.LayerNorm(d_model * 2),
-            nn.ReLU(),
-            nn.Linear(d_model * 2, chunk_size * ACTION_DIM),
-            nn.Tanh(),                                  # [-1, 1]
-        )
-
-    def forward(
-        self,
-        image:    torch.Tensor,   # (B, C, H, W)
-        proprio:  torch.Tensor,   # (B, PROPRIO_DIM)
-        language: torch.Tensor,   # (B, LANGUAGE_DIM)
-        human:    torch.Tensor,   # (B, HUMAN_DIM)
-    ) -> torch.Tensor:
-        B = image.shape[0]
-
-        # Encode modalities
-        img_f  = self.image_enc(image)      # (B, d)
-        prp_f  = self.proprio_enc(proprio)  # (B, d)
-        lng_f  = self.lang_enc(language)    # (B, d)
-        hum_f  = self.human_enc(human)      # (B, d)
-
-        # Fuse via self-attention
-        ctx = torch.stack([img_f, prp_f, lng_f, hum_f], dim=1)  # (B, 4, d)
-        ctx = self.fusion(ctx)                                    # (B, 4, d)
-
-        # Flatten → action chunk
-        flat  = self.flatten_proj(ctx.reshape(B, -1))   # (B, 4d)
-        out   = self.action_head(flat)                  # (B, K*8)
-        chunk = out.reshape(B, self.chunk_size, ACTION_DIM)  # (B, K, 8)
-        return chunk

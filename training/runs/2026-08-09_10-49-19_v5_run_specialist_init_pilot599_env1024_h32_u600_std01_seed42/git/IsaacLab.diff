-#!/usr/bin/env python3
-# SeRT/training/train_safety_evaluator.py
-# Train the Safety Evaluator with supervised BCE loss.
-#
-# Usage:
-#   python SeRT/training/train_safety_evaluator.py \
-#       --data_path data/safety_labels.hdf5 \
-#       --save_path checkpoints/safety_eval.pt
-
-from __future__ import annotations
-
-import argparse
-import os
-
-import torch
-import torch.nn as nn
-from torch.utils.data import DataLoader, random_split
-
-from SeRT.model.safety_evaluator import SafetyEvaluator
-from SeRT.training.dataset import SafetyDataset
-
-
-def train(
-    data_path:  str   = "data/safety_labels.hdf5",
-    save_path:  str   = "checkpoints/safety_eval.pt",
-    epochs:     int   = 200,
-    batch_size: int   = 64,
-    lr:         float = 1e-4,
-    device:     str   = "cuda",
-    val_frac:   float = 0.1,
-    num_workers: int  = 4,
-) -> None:
-    os.makedirs(os.path.dirname(save_path), exist_ok=True)
-
-    ds    = SafetyDataset(data_path)
-    n_val = int(len(ds) * val_frac)
-    n_tr  = len(ds) - n_val
-    tr, va = random_split(ds, [n_tr, n_val])
-
-    tr_ld = DataLoader(tr, batch_size, shuffle=True,  num_workers=num_workers, pin_memory=True)
-    va_ld = DataLoader(va, batch_size, shuffle=False, num_workers=num_workers, pin_memory=True)
-
-    model = SafetyEvaluator().to(device)
-    opt   = torch.optim.AdamW(model.parameters(), lr=lr, weight_decay=1e-4)
-    sched = torch.optim.lr_scheduler.CosineAnnealingLR(opt, T_max=epochs)
-    bce   = nn.BCELoss()
-    best  = float("inf")
-
-    print(f"Training on {n_tr} samples, validating on {n_val} samples.")
-    print(f"Device: {device}  Epochs: {epochs}  Batch: {batch_size}  LR: {lr}")
-
-    for ep in range(1, epochs + 1):
-        # ── Train ──────────────────────────────────────────────────────
-        model.train()
-        tr_loss = 0.0
-        for img, prop, lang, hum, ch, rk, rc in tr_ld:
-            img, prop, lang, hum, ch, rk, rc = [
-                x.to(device) for x in (img, prop, lang, hum, ch, rk, rc)
-            ]
-            out  = model(img, prop, lang, hum, ch)
-            loss = bce(out["risk"], rk) + bce(out["recoverability"], rc)
-            opt.zero_grad()
-            loss.backward()
-            nn.utils.clip_grad_norm_(model.parameters(), 1.0)
-            opt.step()
-            tr_loss += loss.item()
-
-        sched.step()
-
-        # ── Validate ───────────────────────────────────────────────────
-        model.eval()
-        va_loss = 0.0
-        with torch.no_grad():
-            for img, prop, lang, hum, ch, rk, rc in va_ld:
-                img, prop, lang, hum, ch, rk, rc = [
-                    x.to(device) for x in (img, prop, lang, hum, ch, rk, rc)
-                ]
-                out = model(img, prop, lang, hum, ch)
-                va_loss += (bce(out["risk"], rk) + bce(out["recoverability"], rc)).item()
-
-        va_loss /= len(va_ld)
-        tr_loss /= len(tr_ld)
-        print(f"[{ep:3d}/{epochs}] train={tr_loss:.4f}  val={va_loss:.4f}")
-
-        if va_loss < best:
-            best = va_loss
-            torch.save(model.state_dict(), save_path)
-            print(f"  ✓ Saved checkpoint (val={best:.4f}) → {save_path}")
-
-    print(f"\nTraining complete. Best val loss: {best:.4f}")
-
-
-if __name__ == "__main__":
-    parser = argparse.ArgumentParser(description="Train Safety Evaluator")
-    parser.add_argument("--data_path",   default="data/safety_labels.hdf5")
-    parser.add_argument("--save_path",   default="checkpoints/safety_eval.pt")
-    parser.add_argument("--epochs",      type=int,   default=200)
-    parser.add_argument("--batch_size",  type=int,   default=64)
-    parser.add_argument("--lr",          type=float, default=1e-4)
-    parser.add_argument("--device",      default="cuda")
-    parser.add_argument("--val_frac",    type=float, default=0.1)
-    parser.add_argument("--num_workers", type=int,   default=4)
-    args = parser.parse_args()
-
-    train(
-        data_path   = args.data_path,
-        save_path   = args.save_path,
-        epochs      = args.epochs,
-        batch_size  = args.batch_size,
-        lr          = args.lr,
-        device      = args.device,
-        val_frac    = args.val_frac,
-        num_workers = args.num_workers,
-    )

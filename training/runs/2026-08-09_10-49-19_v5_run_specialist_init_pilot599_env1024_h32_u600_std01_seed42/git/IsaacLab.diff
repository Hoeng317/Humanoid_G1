-# SeRT/utils/safety_monitor.py
-# CoppeliaSim scene.py _execute_path_with_safety() 동치.
-#
-# 매 스텝 human_clearance(obs_flat[:, 54])를 EMA 필터로 모니터링.
-# clearance < SAFE_STOP_DIST 시 hold 진입,
-# EMA >= SAFE_RESUME_DIST가 RESUME_SUSTAIN 스텝 지속되면 hold 해제.
-
-from __future__ import annotations
-
-import torch
-
-
-class StepSafetyMonitor:
-    """
-    CoppeliaSim _execute_path_with_safety() 동치.
-
-    사용법:
-        mon = StepSafetyMonitor(num_envs, device)
-        # 매 스텝:
-        clearance = obs_flat[:, 54]           # (B,) human_clearance
-        can_step  = mon.update(clearance, step)
-        if not can_step:
-            env.step(zero_action)             # hold: 제자리 유지
-            continue
-    """
-
-    SAFE_STOP_DIST    = 0.06   # 이하 진입 시 hold
-    SAFE_RESUME_DIST  = 0.09   # 이상 복귀 후 재개 판정
-    EMA_ALPHA         = 0.35   # 지수이동평균 α
-    HOLD_MAX_STEPS    = 300    # hold 최대 유지 스텝 (강제 해제)
-    RESUME_SUSTAIN    = 18     # ~0.3s @ 60Hz: 재개 유지 조건 지속 스텝
-
-    def __init__(self, num_envs: int, device):
-        self.num_envs = num_envs
-        self.device   = device
-        self._ema:            torch.Tensor | None = None
-        self._hold_active:    bool = False
-        self._hold_start_step: int = 0
-        self._resume_ok_since: int | None = None
-
-    def reset(self) -> None:
-        self._ema             = None
-        self._hold_active     = False
-        self._hold_start_step = 0
-        self._resume_ok_since = None
-
-    def update(self, clearance: torch.Tensor, step: int) -> bool:
-        """
-        clearance : (B,) float CUDA — obs_flat[:, 54]
-        step      : 현재 에피소드 스텝 번호
-        Returns   : bool — True면 스텝 실행 가능, False면 hold (제자리 유지)
-        """
-        # ── EMA 갱신 ──────────────────────────────────────────────────────
-        if self._ema is None:
-            self._ema = clearance.clone()
-        else:
-            self._ema = (self.EMA_ALPHA * clearance
-                         + (1.0 - self.EMA_ALPHA) * self._ema)
-
-        # ── hold 진입 조건 ────────────────────────────────────────────────
-        enter_hold = ((clearance < self.SAFE_STOP_DIST)
-                      | (self._ema  < self.SAFE_STOP_DIST))
-
-        if enter_hold.any():
-            if not self._hold_active:
-                self._hold_start_step = step
-            self._hold_active     = True
-            self._resume_ok_since = None
-
-        # ── hold 해제 조건 ─────────────────────────────────────────────────
-        if self._hold_active:
-            # 강제 해제: hold_max_steps 초과
-            if (step - self._hold_start_step) > self.HOLD_MAX_STEPS:
-                self._hold_active = False
-
-            else:
-                # 모든 env가 SAFE_RESUME_DIST 이상일 때 카운트 시작
-                resumable = (self._ema >= self.SAFE_RESUME_DIST).all()
-                if resumable:
-                    if self._resume_ok_since is None:
-                        self._resume_ok_since = step
-                    if (step - self._resume_ok_since) >= self.RESUME_SUSTAIN:
-                        self._hold_active = False
-                else:
-                    self._resume_ok_since = None
-
-        # ── 실행 가능 여부 ────────────────────────────────────────────────
-        # hold 중이거나 현재 clearance가 stop 이하면 false
-        can_step = (not self._hold_active) and bool(
-            (clearance >= self.SAFE_STOP_DIST).all()
-        )
-        return can_step

-
-# ── Success-rate thresholds before running collect_safety_labels.py ──────────
-_MIN_SUCCESS_RATE = {
-    "reach":         0.90,
-    "grasp":         0.70,
-    "lift":          0.75,
-    "place":         0.75,
-    "return":        0.70,
-}
-
-
-def train(
-    demo_dir:    str   = "data/il_demos/grasp",
-    save_path:   str   = "checkpoints/il_policy_grasp.pt",
-    task_name:   str   = "grasp",
-    epochs:      int   = 150,
-    batch_size:  int   = 64,
-    lr:          float = 1e-4,
-    val_frac:    float = 0.1,
-    device:      str   = "cuda",
-    num_workers: int   = 4,
-) -> None:
-    os.makedirs(os.path.dirname(save_path), exist_ok=True)
-
-    ds    = ILDataset(demo_dir)
-    n_val = max(1, int(len(ds) * val_frac))
-    n_tr  = len(ds) - n_val
-    tr, va = random_split(ds, [n_tr, n_val])
-
-    tr_ld = DataLoader(tr, batch_size, shuffle=True,
-                       num_workers=num_workers, pin_memory=True)
-    va_ld = DataLoader(va, batch_size, shuffle=False,
-                       num_workers=num_workers, pin_memory=True)
-
-    model = ILPolicy().to(device)
-    opt   = torch.optim.AdamW(model.parameters(), lr=lr, weight_decay=1e-4)
-    sched = torch.optim.lr_scheduler.CosineAnnealingLR(opt, T_max=epochs)
-    mse   = nn.MSELoss()
-    best  = float("inf")
-
-    min_sr = _MIN_SUCCESS_RATE.get(task_name, 0.7)
-    print(f"Training ILPolicy for task='{task_name}'")
-    print(f"  {n_tr} train / {n_val} val  epochs={epochs}  "
-          f"batch={batch_size}  lr={lr}  device={device}")
-    print(f"  Target: val loss ↓ (min success rate benchmark = {min_sr:.0%})")
-
-    for ep in range(1, epochs + 1):
-        # ── Train ─────────────────────────────────────────────────────────
-        model.train()
-        tr_loss = 0.0
-        for img, prop, lang, hum, gt_chunk in tr_ld:
-            img, prop, lang, hum, gt_chunk = [
-                x.to(device) for x in (img, prop, lang, hum, gt_chunk)
-            ]
-            pred = model(img, prop, lang, hum)
-            loss = mse(pred, gt_chunk)
-            opt.zero_grad()
-            loss.backward()
-            nn.utils.clip_grad_norm_(model.parameters(), 1.0)
-            opt.step()
-            tr_loss += loss.item()
-
-        sched.step()
-
-        # ── Validate ───────────────────────────────────────────────────────
-        model.eval()
-        va_loss = 0.0
-        with torch.no_grad():
-            for img, prop, lang, hum, gt_chunk in va_ld:
-                img, prop, lang, hum, gt_chunk = [
-                    x.to(device) for x in (img, prop, lang, hum, gt_chunk)
-                ]
-                pred = model(img, prop, lang, hum)
-                va_loss += mse(pred, gt_chunk).item()
-
-        va_loss /= len(va_ld)
-        tr_loss /= len(tr_ld)
-
-        if ep % 10 == 0 or ep == 1:
-            print(f"[{ep:3d}/{epochs}] train={tr_loss:.5f}  val={va_loss:.5f}")
-
-        if va_loss < best:
-            best = va_loss
-            torch.save(model.state_dict(), save_path)
-            if ep % 10 == 0:
-                print(f"  ✓ Saved (val={best:.5f}) → {save_path}")
-
-    print(f"\nTraining complete. Best val loss: {best:.5f}")
-    print(f"Checkpoint: {save_path}")
-    print(f"Next step: run collect_safety_labels.py with this checkpoint "
-          f"(ensure sim success rate ≥ {min_sr:.0%} first).")
-
-
-if __name__ == "__main__":
-    p = argparse.ArgumentParser()
-    p.add_argument("--demo_dir",    default="data/il_demos/grasp")
-    p.add_argument("--save_path",   default="checkpoints/il_policy_grasp.pt")
-    p.add_argument("--task_name",   default="grasp")
-    p.add_argument("--epochs",      type=int,   default=150)
-    p.add_argument("--batch_size",  type=int,   default=64)
-    p.add_argument("--lr",          type=float, default=1e-4)
-    p.add_argument("--val_frac",    type=float, default=0.1)
-    p.add_argument("--device",      default="cuda")
-    p.add_argument("--num_workers", type=int,   default=4)
-    args = p.parse_args()
-
-    train(

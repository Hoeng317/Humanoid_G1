-# SeRT/policies/scripted_task_policy.py
-# Phase-Aware scripted policy for HRC tasks.
-#
-# grasp_center (손가락 바디 원점 중간점) ≈ EE 위치 (손가락 바디 원점이 hand frame 근처)
-# 따라서 handover 조건 = ||EE - offer_pos|| < 0.06m
-#
-# Phase 0 (Approach):  2단계: hover(XY 정렬) → grasp_pos(offer+10cm, Z 하강)
-#                      gripper OPEN / d_grasp < GRASP_EPS → Phase 1
-# Phase 1 (Descend):   EE → offer_pos (직접), gripper CLOSE
-#                      d_offer < OFFER_EPS → Phase 2
-# Phase 2 (Hold):      EE 유지 at offer_pos, gripper CLOSE
-#                      obs robot_owner=1 → Phase 3
-# Phase 3 (Goal):      EE → goal_pos (task별 목표), gripper HOLD
-
-from __future__ import annotations
-
-import torch
-
-from SeRT.model.config import CHUNK_SIZE, ACTION_DIM, EE_POS_IDX
-
-# ── 파라미터 ───────────────────────────────────────────────────────────────────
-ENV_DT_SCALE    = 0.25 * 0.05      # = 0.0125
-
-FINGER_Z_OFFSET = 0.10             # m: Phase 0 목표 높이 (offer 위 10cm)
-HOVER_Z         = 0.30             # m: Phase 0 hover 높이 (offer 위 30cm)
-
-XY_ALIGN_THRESH = 0.04             # m: XY 정렬 완료 기준
-GRASP_EPS       = 0.10             # m: Phase 0→1 전환 (grasp_pos 도달)
-OFFER_EPS       = 0.12             # m: Phase 1→2 전환 (offer_pos 도달)
-
-CLOSE_THRESH    = 0.05             # m: gripper 완전히 닫힘
-
-PROP_GAIN_XY    = 10.0             # XY 정렬
-PROP_GAIN_Z     = 12.0             # Z 하강 (grasp_pos)
-PROP_GAIN_OFF   = 14.0             # offer_pos 접근 (phase 1)
-PROP_GAIN_HOLD  =  8.0             # hold / goal tracking
-MAX_DELTA       =  1.0             # m: 스텝당 최대 Cartesian 이동량
-
-# obs indices
-_OBS_ROBOT_OWNER = 53              # obs_flat[:, 53] = robot owns cube (float)
-
-
-class PhaseAwarePolicy:
-    """
-    HRC 멀티태스크 스크립트 정책.
-
-    Phase 0: hover → grasp_pos (offer+10cm) 접근, gripper OPEN
-    Phase 1: offer_pos 직접 접근, gripper CLOSE
-    Phase 2: offer_pos 유지, gripper CLOSE (handover 대기)
-    Phase 3: goal_pos 이동, gripper HOLD (cube 운반)
-    """
-
-    def __init__(self, env, chunk_size: int = CHUNK_SIZE):
-        self._uw        = env.unwrapped if hasattr(env, "unwrapped") else env
-        self.num_envs   = self._uw.num_envs
-        self.device     = self._uw.device
-        self.chunk_size = chunk_size
-        self.phase      = torch.zeros(self.num_envs, dtype=torch.long, device=self.device)
-
-    def reset(self, env_ids: torch.Tensor | None = None) -> None:
-        if env_ids is None:
-            env_ids = torch.arange(self.num_envs, device=self.device)
-        self.phase[env_ids] = 0
-
-    # ------------------------------------------------------------------
-    def _jacobian(self) -> torch.Tensor | None:
-        try:
-            J_all = self._uw._robot.root_physx_view.get_jacobians()
-            ee_id = self._uw._ee_body_id
-            if self._uw._robot.is_fixed_base:
-                ee_id = ee_id - 1
-            return J_all[:, ee_id, :3, :7]
-        except Exception:
-            return None
-
-    @staticmethod
-    def _ik(J: torch.Tensor | None, delta_x: torch.Tensor, B: int, device) -> torch.Tensor:
-        if J is not None:
-            lam = 1e-4
-            JJT = J @ J.transpose(-1, -2) + lam * torch.eye(3, device=device)
-            return (J.transpose(-1, -2) @
-                    torch.linalg.solve(JJT, delta_x.unsqueeze(-1))).squeeze(-1)
-        return delta_x.norm(dim=-1, keepdim=True).expand(B, 7) * 0.01
-
-    # ------------------------------------------------------------------
-    def predict(
-        self,
-        obs_flat:  torch.Tensor,   # (B, 57)
-        offer_pos: torch.Tensor,   # (B, 3)  — human hand (current)
-        goal_pos:  torch.Tensor,   # (B, 3)  — task goal
-    ) -> torch.Tensor:
-        """Return (B, K, ACTION_DIM) delta-action chunk."""
-        B      = obs_flat.shape[0]
-        device = obs_flat.device
-
-        ee_pos    = obs_flat[:, EE_POS_IDX : EE_POS_IDX + 3]   # (B, 3)
-        gripper_w = obs_flat[:, 51]                              # (B,)
-
-        # cube ownership from obs (float: 1.0=robot, 0.0=human/none)
-        robot_owner = obs_flat[:, _OBS_ROBOT_OWNER] > 0.5       # (B,) bool
-
-        finger_offset = torch.tensor([0.0, 0.0, FINGER_Z_OFFSET], device=device)
-        hover_offset  = torch.tensor([0.0, 0.0, HOVER_Z],         device=device)
-        grasp_pos = offer_pos + finger_offset   # offer+10cm  (B, 3)
-        hover_pos = offer_pos + hover_offset    # offer+30cm  (B, 3)
-
-        # ── phase 전환 ────────────────────────────────────────────────────
-        d_grasp = torch.norm(ee_pos - grasp_pos, dim=-1)
-        d_offer = torch.norm(ee_pos - offer_pos, dim=-1)
-
-        self.phase[(self.phase == 0) & (d_grasp < GRASP_EPS)]    = 1
-        # Phase 1→2: offer_pos 도달 OR gripper 완전히 닫힘 (offer_pos가 움직이므로 두 조건 중 하나)
-        phase1_to_2 = (self.phase == 1) & ((d_offer < OFFER_EPS) | (gripper_w < CLOSE_THRESH))
-        self.phase[phase1_to_2]                                   = 2
-        self.phase[(self.phase == 2) & robot_owner]               = 3
-
-        # ── Jacobian ──────────────────────────────────────────────────────
-        J = self._jacobian()
-
-        # ── K 스텝 chunk 생성 ──────────────────────────────────────────────
-        pred_phase = self.phase.clone()
-        pred_ee    = ee_pos.clone()
-        pred_gw    = gripper_w.clone()
-        chunk = torch.zeros(B, self.chunk_size, ACTION_DIM, device=device)
-
-        for k in range(self.chunk_size):
-            # ── 타겟 ────────────────────────────────────────────────────
-            xy_dist    = torch.norm(pred_ee[:, :2] - grasp_pos[:, :2], dim=-1)
-            need_hover = (pred_phase == 0) & (xy_dist > XY_ALIGN_THRESH)
-
-            target = grasp_pos.clone()                   # Phase 0 (Z align)
-            target[need_hover]           = hover_pos[need_hover]   # Phase 0 (XY align)
-            target[pred_phase == 1]      = offer_pos[pred_phase == 1]  # Phase 1
-            target[pred_phase == 2]      = offer_pos[pred_phase == 2]  # Phase 2 hold
-            target[pred_phase >= 3]      = goal_pos[pred_phase >= 3]   # Phase 3
-
-            # ── gain ────────────────────────────────────────────────────
-            gain = torch.where(
-                need_hover,
-                torch.full((B,), PROP_GAIN_XY,  device=device),
-                torch.where(
-                    pred_phase == 0,
-                    torch.full((B,), PROP_GAIN_Z,   device=device),
-                    torch.where(
-                        pred_phase == 1,
-                        torch.full((B,), PROP_GAIN_OFF,  device=device),
-                        torch.full((B,), PROP_GAIN_HOLD, device=device),
-                    )
-                )
-            )
-
-            # ── gripper ─────────────────────────────────────────────────
-            # Phase 0: OPEN / Phase 1,2: CLOSE / Phase 3: HOLD
-            gripper_cmd = torch.ones(B, device=device)           # open
-            gripper_cmd[(pred_phase == 1) | (pred_phase == 2)] = -1.0  # close
-            gripper_cmd[pred_phase >= 3]                        =  0.0  # hold
-
-            # ── IK → action ─────────────────────────────────────────────
-            raw_delta = (target - pred_ee) * gain.unsqueeze(-1)
-            delta_x   = torch.clamp(raw_delta, -MAX_DELTA, MAX_DELTA)
-            dq        = self._ik(J, delta_x, B, device)
-            action_k  = torch.clamp(dq / ENV_DT_SCALE, -1.0, 1.0)
-            chunk[:, k, :7] = action_k
-            chunk[:, k,  7] = gripper_cmd
-
-            # ── 예측 상태 전진 ───────────────────────────────────────────
-            dq_actual = action_k * ENV_DT_SCALE
-            if J is not None:
-                pred_ee = pred_ee + (J @ dq_actual.unsqueeze(-1)).squeeze(-1)
-            else:
-                pred_ee = pred_ee + delta_x * ENV_DT_SCALE
-            pred_gw = (pred_gw + gripper_cmd * 0.005).clamp(0.0, 0.08)
-
-            # chunk 내 phase 전진 (robot_owner는 외부 이벤트라 제외)
-            d_g = torch.norm(pred_ee - grasp_pos, dim=-1)
-            d_o = torch.norm(pred_ee - offer_pos, dim=-1)
-            pred_phase[(pred_phase == 0) & (d_g < GRASP_EPS)] = 1
-            pred_phase[(pred_phase == 1) & (d_o < OFFER_EPS)] = 2
-
-        return chunk   # (B, K, 8)
